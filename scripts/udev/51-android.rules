# Android ADB udev rules — grant non-root access to USB-connected phones.
# Install once on the host (then replug the device):
#   sudo cp scripts/udev/51-android.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Without this, `adb devices` reports "no permissions" and you must chmod the
# /dev/bus/usb node by hand after every replug/reboot.

# Xiaomi / Redmi / POCO
SUBSYSTEM=="usb", ATTR{idVendor}=="2717", MODE="0666", GROUP="plugdev"
# Google / generic ADB
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", MODE="0666", GROUP="plugdev"
# Samsung
SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", MODE="0666", GROUP="plugdev"
