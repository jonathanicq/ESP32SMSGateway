# Environment mode (controls Docker branch selection): production | development
APP_ENV=development
APP_VERSION=0.1.0
GIT_COMMIT=unknown

# Database (MySQL in deploy; SQLite fallback for local dev)
DATABASE_URL=mysql+pymysql://smsgw:changeme@db:3306/sms_gateway

# Auth / JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
IMPERSONATION_TTL_MINUTES=60

# Master account (MANDATORY — seeded on first startup if no super admin exists)
SUPER_ADMIN_EMAIL=admin@thecoordinates.xyz
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Execution logging (makebdd.execution_logs) — leave unset to disable (best-effort)
# EXEC_LOG_DB_URL=mysql+pymysql://makeuser:PASSWORD@mysql.thecoordinates.xyz:3306/makebdd
EXEC_LOG_APP_NAME=android-sms-gateway

# WhatsApp bridge (premium) — WAHA. Leave WAHA_BASE_URL unset to disable.
# WAHA_BASE_URL=http://192.168.0.135:3099
# WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
WHATSAPP_TRIGGER_KEYWORD=@sms
WHATSAPP_WEBHOOK_TOKEN=replace-with-a-random-token
# Grammar for WhatsApp→SMS: "<trigger> <E164> <message>"  e.g.  @sms +447700900123 Hello

# Telegram bridge — Telegram Bot API. Leave empty to disable.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_WEBHOOK_CHAT_ID=987654321
TELEGRAM_SMS_TRIGGER_KEYWORD=/sms
# Grammar for Telegram→SMS: "<trigger> <E164> <message>"  e.g.  /sms +447700900123 Hello
